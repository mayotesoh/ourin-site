# Notion インテグレーションのシークレット（ntn_ から始まる文字列）
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 活動報告（ブログ）データベースID（32桁）
NOTION_BLOG_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 予約データベースID（32桁）※GAS側のスクリプトプロパティにも同じ値を入れます
NOTION_RESERVE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# メニュー（占術メニュー）データベースID ※任意。未設定なら固定文言で表示されます
NOTION_MENU_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
