---
import Layout from '../../layouts/Layout.astro';
import {
  queryDatabase,
  getTitle,
  getDateStr,
  getSlug,
  getStatus,
  getMultiSelect,
  getImageUrl,
  getText,
  formatDate,
} from '../../lib/notion';
import { withBase } from '../../lib/url';

const blogDbId = import.meta.env.NOTION_BLOG_ID;
const pages = await queryDatabase(blogDbId, {});

const posts = pages
  .filter((p: any) => {
    const s = getStatus(p);
    return s === '' || s === '公開' || s === 'Published' || s === '完了';
  })
  .map((p: any) => ({
    title: getTitle(p),
    date: getDateStr(p),
    slug: getSlug(p),
    categories: getMultiSelect(p),
    image: getImageUrl(p),
    summary: getText(p, ['概要', '抜粋', 'サマリー']),
  }))
  .sort((a, b) => (a.date < b.date ? 1 : -1));

const categories = [...new Set(posts.flatMap((p) => p.categories))].filter(Boolean);
---

<Layout title="活動報告" description="占い師・凰凛の活動報告。イベント出店・セッションの様子・日々の気づきをお届けします。">
  <section class="section">
    <div class="container">
      <div class="text-center reveal">
        <span class="section-label">Report</span>
        <h1 class="section-title">活動報告</h1>
        <p class="section-lead">イベント出店やセッションの様子、日々受け取ったメッセージを綴っています。</p>
      </div>

      {posts.length > 0 ? (
        <>
          <div class="filters reveal">
            <label class="search">
              <span class="search-icon" aria-hidden="true">✧</span>
              <input type="search" id="post-search" placeholder="キーワードで探す" autocomplete="off" />
            </label>
            {categories.length > 0 && (
              <div class="chips" id="category-chips">
                <button class="chip active" data-cat="all" type="button">すべて</button>
                {categories.map((c) => (
                  <button class="chip" data-cat={c} type="button">{c}</button>
                ))}
              </div>
            )}
          </div>

          <div class="post-grid" id="post-grid">
            {posts.map((post) => (
              <a
                class="post-card reveal"
                href={withBase(`/blog/${post.slug}`)}
                data-title={post.title}
                data-cats={post.categories.join(',')}
              >
                <div class="post-thumb">
                  {post.image ? <img src={post.image} alt="" loading="lazy" /> : <span class="post-thumb-mark">✧</span>}
                </div>
                <div class="post-body">
                  <p class="post-date">{formatDate(post.date)}</p>
                  <h2 class="post-title">{post.title}</h2>
                  {post.summary && <p class="post-summary">{post.summary}</p>}
                  {post.categories.length > 0 && (
                    <p class="post-tags">{post.categories.map((c) => <span class="tag">{c}</span>)}</p>
                  )}
                </div>
              </a>
            ))}
          </div>

          <p class="no-result" id="no-result" hidden>該当する記事が見つかりませんでした。</p>
        </>
      ) : (
        <div class="card empty reveal">
          <p>ただいま準備中です。</p>
          <p class="empty-note">
            Notionの活動報告データベースに記事を追加して「ステータス＝公開」にすると、ここに一覧が表示されます。
          </p>
        </div>
      )}
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    var search = document.getElementById('post-search');
    var chips = document.getElementById('category-chips');
    var grid = document.getElementById('post-grid');
    var noResult = document.getElementById('no-result');
    if (!grid) return;

    var cards = Array.prototype.slice.call(grid.querySelectorAll('.post-card'));
    var activeCat = 'all';

    function apply() {
      var q = (search && search.value ? search.value : '').toLowerCase().trim();
      var shown = 0;
      cards.forEach(function (card) {
        var title = (card.getAttribute('data-title') || '').toLowerCase();
        var cats = card.getAttribute('data-cats') || '';
        var matchText = !q || title.indexOf(q) !== -1 || cats.toLowerCase().indexOf(q) !== -1;
        var matchCat = activeCat === 'all' || cats.split(',').indexOf(activeCat) !== -1;
        var visible = matchText && matchCat;
        card.style.display = visible ? '' : 'none';
        if (visible) shown++;
      });
      if (noResult) noResult.hidden = shown !== 0;
    }

    if (search) search.addEventListener('input', apply);
    if (chips) {
      chips.addEventListener('click', function (e) {
        var btn = e.target.closest('.chip');
        if (!btn) return;
        chips.querySelectorAll('.chip').forEach(function (c) { c.classList.remove('active'); });
        btn.classList.add('active');
        activeCat = btn.getAttribute('data-cat');
        apply();
      });
    }
  })();
</script>

<style>
  .filters { display: flex; flex-direction: column; align-items: center; gap: 20px; margin: 44px 0 40px; }
  .search { position: relative; width: min(100%, 460px); }
  .search-icon { position: absolute; left: 18px; top: 50%; transform: translateY(-50%); color: var(--gold); }
  #post-search {
    width: 100%;
    padding: 13px 20px 13px 44px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.05);
    color: var(--text);
    font-family: inherit;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  #post-search::placeholder { color: rgba(167, 159, 192, 0.7); }
  #post-search:focus { border-color: var(--gold); background: rgba(255, 255, 255, 0.08); }

  .chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .chip {
    padding: 7px 18px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: transparent;
    color: var(--muted);
    font-family: inherit;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .chip:hover { color: var(--gold-bright); border-color: var(--line); }
  .chip.active { background: rgba(212, 175, 106, 0.16); border-color: var(--gold); color: var(--gold-bright); }

  .post-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 26px; }
  .post-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var(--panel);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .post-card:hover { transform: translateY(-4px); border-color: var(--line); box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35); }
  .post-thumb {
    aspect-ratio: 16 / 10;
    background: linear-gradient(150deg, rgba(138, 118, 216, 0.28), rgba(212, 175, 106, 0.16));
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .post-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .post-thumb-mark { font-size: 1.8rem; color: var(--gold); }
  .post-body { padding: 20px 22px 24px; }
  .post-date { font-size: 0.75rem; letter-spacing: 0.16em; color: var(--gold); margin: 0 0 8px; }
  .post-title { font-size: 1.08rem; margin: 0 0 10px; line-height: 1.7; }
  .post-summary { color: var(--muted); font-size: 0.88rem; margin: 0 0 14px; }
  .post-tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; }
  .tag { font-size: 0.72rem; color: var(--muted); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 999px; padding: 2px 12px; }

  .no-result { text-align: center; color: var(--muted); margin-top: 40px; }
  .empty { margin-top: 48px; text-align: center; color: var(--muted); }
  .empty-note { font-size: 0.85rem; }
</style>
