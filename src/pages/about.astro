---
import Layout from '../layouts/Layout.astro';
import SnsIcons from '../components/SnsIcons.astro';
import { PROFILE_IMAGE, SNS_LINKS, SERVICES } from '../consts';
import { withBase } from '../lib/url';

// ★プロフィール本文（クライアント資料の文面。必要に応じて追記・修正してください）
const intro = [
  '46歳、2児のシングルマザーです。',
  '育児と仕事を両立しながら、テレアポ・営業代行・イベント事業の3つを手がけています。',
  '「時間も収入も、自分でコントロールできる働き方」を実践しながら、同じ境遇の女性たちが一歩踏み出せる環境づくりに取り組んでいます。',
];

// ★大切にしていること（自由に編集）
const values = [
  {
    title: '選択肢をつくる',
    text: '働き方は一つではありません。在宅・副業・フルコミッション・占い師としての活動——その人の状況に合う入り口を用意しています。',
  },
  {
    title: '一歩目を軽くする',
    text: '未経験でも始められるよう、スクリプトやリストの用意、育成、マインドのサポートまで含めて伴走します。',
  },
  {
    title: '誠実な仕事だけを',
    text: '取り扱う案件は代表が厳選し、グレーな案件はお断りしています。長く続けられる仕事だけをお渡しします。',
  },
];

// ★これまでの歩み（年号が決まったら year に入れてください）
const timeline = [
  { year: '', text: 'シングルマザーとして、育児と両立できる働き方を模索しはじめる' },
  { year: '', text: 'テレアポ・営業代行の事業を立ち上げ、在宅で働くメンバーの育成を開始' },
  { year: '', text: '大阪・天満のイベントスペース「Branch Cafe」にて、年間500回以上のイベントを運営' },
  { year: '3月', text: '占い師専門コミュニティの定例会がスタート。紹介の輪が広がり続けています' },
];

const hasSns = SNS_LINKS.some((s) => s.url);
---

<Layout
  title="プロフィール"
  description="46歳、2児のシングルマザー。テレアポ・営業代行・占いコミュニティの3事業を通じて、女性が自分らしく働ける環境づくりに取り組んでいます。"
>
  <section class="section">
    <div class="container">
      <div class="text-center reveal">
        <span class="section-label">Profile</span>
        <h1 class="section-title">プロフィール</h1>
      </div>

      <div class="profile reveal">
        <div class="profile-photo">
          <img src={withBase(PROFILE_IMAGE)} alt="松山倫子" width="420" height="520" />
        </div>
        <div class="profile-body">
          <p class="profile-name">松山 倫子<span>まつやま のりこ</span></p>
          <p class="profile-role">占いコミュニティ ／ テレアポ ／ 営業代行</p>
          {intro.map((p) => <p class="profile-text">{p}</p>)}

          <div class="profile-tags">
            {SERVICES.map((s) => (
              <a class="profile-tag" href={withBase(`/service/${s.id}`)}>{s.name}</a>
            ))}
          </div>

          {hasSns && (
            <div class="profile-sns">
              <span class="profile-sns-label">Follow</span>
              <SnsIcons size={20} gap={16} />
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- 占い師としての名前 -->
  <section class="section-sm">
    <div class="container">
      <div class="alias reveal">
        <div class="alias-mark">
          <img src={withBase('/images/ourin-logo-ink.png')} alt="凰凛" width="200" height="282" loading="lazy" />
        </div>
        <div class="alias-text">
          <span class="section-label">Another Name</span>
          <h2 class="section-title left">もうひとつの名前、<br />凰凛（おうりん）。</h2>
          <p>
            占い師としては「凰凛（おうりん）」という名前で活動しています。
            チャネリングとルノルマンカードで、その人の「いま」に必要なメッセージをお伝えする——
            現場に立ち続けてきたこの経験が、占い師のためのコミュニティづくりの土台になっています。
          </p>
          <div class="alias-tags">
            <span class="alias-tag">チャネリング</span>
            <span class="alias-tag">ルノルマンカード</span>
          </div>
          <div class="alias-actions">
            <a href={withBase('/ourin')} class="btn btn-primary">占い師 凰凛のページへ</a>
            <a href={withBase('/contact')} class="btn btn-ghost">個人鑑定を相談する</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <div class="text-center reveal">
        <span class="section-label">Policy</span>
        <h2 class="section-title">大切にしていること</h2>
      </div>
      <div class="value-grid">
        {values.map((v, i) => (
          <div class="card value-card reveal">
            <span class="value-no">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="value-title">{v.title}</h3>
            <p class="value-text">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="text-center reveal">
        <span class="section-label">History</span>
        <h2 class="section-title">これまでの歩み</h2>
      </div>
      <ul class="timeline reveal">
        {timeline.map((t) => (
          <li class="timeline-item">
            {t.year && <span class="timeline-year">{t.year}</span>}
            <span class="timeline-text">{t.text}</span>
          </li>
        ))}
      </ul>
      <p class="note text-center">最新の活動は<a href={withBase('/blog')}>活動報告</a>とSNSでお知らせしています。</p>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <div class="cta reveal">
        <h2 class="cta-title">一緒に、新しいステージへ</h2>
        <p class="cta-text">気になる事業があれば、まずはお気軽にご相談ください。</p>
        <div class="cta-actions">
          <a href={withBase('/service')} class="btn btn-ghost">事業内容を見る</a>
          <a href={withBase('/contact')} class="btn btn-primary">お問い合わせ</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .profile { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 48px; align-items: center; margin-top: 48px; }
  .profile-photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: top center;
    border-radius: 200px 200px 20px 20px;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
  }
  .profile-name { font-family: var(--font-serif); font-size: 1.8rem; letter-spacing: 0.3em; margin: 0 0 6px; }
  .profile-name span { font-size: 0.68rem; letter-spacing: 0.28em; color: var(--muted); margin-left: 14px; }
  .profile-role { font-size: 0.82rem; letter-spacing: 0.2em; color: var(--accent); margin: 0 0 26px; }
  .profile-text { color: var(--muted); margin: 0 0 1.2em; }

  .profile-tags { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .profile-tag {
    font-size: 0.82rem;
    text-decoration: none;
    color: var(--accent-deep);
    background: var(--accent-pale);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 6px 16px;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .profile-tag:hover { background: #c3f2df; transform: translateY(-2px); }

  .profile-sns { display: flex; align-items: center; gap: 16px; margin-top: 30px; padding-top: 26px; border-top: 1px solid var(--border); }
  .profile-sns-label { font-family: var(--font-serif); font-size: 0.7rem; letter-spacing: 0.26em; color: var(--muted); }


  /* 占い師としての名前ブロック */
  .alias {
    display: grid;
    grid-template-columns: 0.34fr 0.66fr;
    gap: 44px;
    align-items: center;
    padding: 44px 46px;
    background: linear-gradient(160deg, rgba(213, 247, 232, 0.75), var(--panel) 65%);
    border: 1px solid var(--border);
    border-radius: 22px;
    box-shadow: var(--shadow-sm);
  }
  .alias-mark { display: flex; justify-content: center; }
  .alias-mark img { height: 220px; width: auto; opacity: 0.9; }
  .alias-text p { color: var(--muted); margin: 0 0 22px; }
  .alias-tags { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 26px; }
  .alias-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .alias-tag {
    font-size: 0.82rem;
    color: var(--accent-deep);
    background: var(--accent-pale);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 6px 16px;
  }

  .value-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; margin-top: 44px; }
  .value-card { position: relative; }
  .value-no { font-family: var(--font-serif); font-size: 0.8rem; letter-spacing: 0.2em; color: var(--accent); }
  .value-title { font-size: 1.12rem; margin: 10px 0 12px; }
  .value-text { color: var(--muted); font-size: 0.92rem; margin: 0; }

  .timeline { list-style: none; margin: 44px 0 0; padding: 0 0 0 22px; border-left: 1px solid var(--line); }
  .timeline-item { position: relative; padding: 0 0 26px 24px; }
  .timeline-item::before {
    content: '';
    position: absolute;
    left: -28px;
    top: 12px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px rgba(14, 165, 120, 0.16);
  }
  .timeline-year { display: block; font-family: var(--font-serif); font-size: 0.8rem; letter-spacing: 0.2em; color: var(--accent); }
  .timeline-text { color: var(--muted); }

  .note { color: var(--muted); font-size: 0.88rem; margin-top: 26px; }

  .cta {
    text-align: center;
    padding: 48px 28px;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: linear-gradient(160deg, rgba(111, 224, 180, 0.3), rgba(255, 255, 255, 0.9));
    box-shadow: var(--shadow-sm);
  }
  .cta-title { font-size: 1.5rem; margin: 0 0 14px; }
  .cta-text { color: var(--muted); margin: 0 0 26px; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; }

  @media (max-width: 860px) {
    .alias { grid-template-columns: 1fr; gap: 28px; padding: 32px 26px; text-align: center; }
    .alias-mark img { height: 150px; }
    .alias-tags { justify-content: center; }
    .profile { grid-template-columns: 1fr; gap: 32px; }
    .profile-photo { max-width: 320px; margin-inline: auto; }
    .profile-name { text-align: center; }
    .profile-role { text-align: center; }
  }
</style>
