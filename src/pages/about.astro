---
import Layout from '../layouts/Layout.astro';
import SnsIcons from '../components/SnsIcons.astro';
import { PROFILE_IMAGE, SNS_LINKS } from '../consts';
import { withBase } from '../lib/url';

// ★ここの文章は自由に書き換えてください（プロフィール本文）
const intro = [
  'はじめまして。占い師の凰凛（おうりん）です。',
  'チャネリングとルノルマンカードを使って、ご相談者さまの「いま」に必要なメッセージをお届けしています。',
  '占いは、答えを押しつけるものではありません。あなたのなかにすでにある答えに、そっと光をあてる時間だと思っています。',
];

// ★大切にしていること（自由に編集）
const values = [
  { title: '否定しない', text: 'どんなご相談も、まずはそのまま受け止めます。責めたり、脅したりする鑑定はいたしません。' },
  { title: '現実に活かせる言葉で', text: '抽象的な表現で終わらせず、明日から実際に動ける形までかみ砕いてお伝えします。' },
  { title: '見えないものと、現実の両方から', text: 'チャネリングで受け取る流れと、ルノルマンが示す具体的な状況。両面から立体的に読み解きます。' },
];

// ★経歴・活動（自由に編集／不要な行は削除してください）
const timeline = [
  { year: '', text: 'チャネリングによるセッションを開始' },
  { year: '', text: 'ルノルマンカードによるリーディングを本格的に取り入れる' },
  { year: '', text: '対面・オンラインでの個人鑑定、イベント出店を中心に活動中' },
];

const hasSns = SNS_LINKS.some((s) => s.url);
---

<Layout title="凰凛について" description="占い師・凰凛（おうりん）のプロフィール。チャネリングとルノルマンカードで、あなたの「今」に必要なメッセージをお届けします。">
  <section class="section">
    <div class="container">
      <div class="text-center reveal">
        <span class="section-label">Profile</span>
        <h1 class="section-title">凰凛について</h1>
      </div>

      <div class="profile reveal">
        <div class="profile-photo">
          <img src={withBase(PROFILE_IMAGE)} alt="占い師 凰凛" width="420" height="520" />
        </div>
        <div class="profile-body">
          <p class="profile-name">凰 凛<span>おうりん</span></p>
          <p class="profile-role">チャネリング／ルノルマンカード</p>
          {intro.map((p) => <p class="profile-text">{p}</p>)}

          {hasSns && (
            <div class="profile-sns">
              <span class="profile-sns-label">Follow</span>
              <SnsIcons size={20} gap={16} />
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <div class="text-center reveal">
        <span class="section-label">Policy</span>
        <h2 class="section-title">鑑定で大切にしていること</h2>
      </div>
      <div class="value-grid">
        {values.map((v, i) => (
          <div class="card value-card reveal">
            <span class="value-no">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="value-title">{v.title}</h3>
            <p class="value-text">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="text-center reveal">
        <span class="section-label">History</span>
        <h2 class="section-title">これまでの活動</h2>
      </div>
      <ul class="timeline reveal">
        {timeline.map((t) => (
          <li class="timeline-item">
            {t.year && <span class="timeline-year">{t.year}</span>}
            <span class="timeline-text">{t.text}</span>
          </li>
        ))}
      </ul>
      <p class="note text-center">最新の活動は<a href={withBase("/blog")}>活動報告</a>とSNSでお知らせしています。</p>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <div class="cta reveal">
        <h2 class="cta-title">鑑定をご希望の方へ</h2>
        <p class="cta-text">メニュー・料金をご確認のうえ、予約フォームよりお申し込みください。</p>
        <div class="cta-actions">
          <a href={withBase("/menu")} class="btn btn-ghost">占術メニュー</a>
          <a href={withBase("/reserve")} class="btn btn-primary">ご予約へ進む</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .profile { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 48px; align-items: center; margin-top: 48px; }
  .profile-photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: top center;
    border-radius: 200px 200px 20px 20px;
    border: 1px solid var(--line);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }
  .profile-name { font-family: var(--font-serif); font-size: 1.8rem; letter-spacing: 0.3em; margin: 0 0 6px; }
  .profile-name span { font-size: 0.68rem; letter-spacing: 0.28em; color: var(--muted); margin-left: 14px; }
  .profile-role { font-size: 0.82rem; letter-spacing: 0.2em; color: var(--gold); margin: 0 0 26px; }
  .profile-text { color: var(--muted); margin: 0 0 1.2em; }
  .profile-sns { display: flex; align-items: center; gap: 16px; margin-top: 30px; padding-top: 26px; border-top: 1px solid rgba(255, 255, 255, 0.1); }
  .profile-sns-label { font-family: var(--font-serif); font-size: 0.7rem; letter-spacing: 0.26em; color: var(--muted); }

  .value-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; margin-top: 44px; }
  .value-card { position: relative; }
  .value-no { font-family: var(--font-serif); font-size: 0.8rem; letter-spacing: 0.2em; color: var(--gold); }
  .value-title { font-size: 1.12rem; margin: 10px 0 12px; }
  .value-text { color: var(--muted); font-size: 0.92rem; margin: 0; }

  .timeline { list-style: none; margin: 44px 0 0; padding: 0 0 0 22px; border-left: 1px solid var(--line); }
  .timeline-item { position: relative; padding: 0 0 26px 24px; }
  .timeline-item::before {
    content: '';
    position: absolute;
    left: -28px;
    top: 12px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 0 4px rgba(212, 175, 106, 0.16);
  }
  .timeline-year { display: block; font-family: var(--font-serif); font-size: 0.8rem; letter-spacing: 0.2em; color: var(--gold); }
  .timeline-text { color: var(--muted); }

  .note { color: var(--muted); font-size: 0.88rem; margin-top: 26px; }

  .cta { text-align: center; padding: 48px 28px; border: 1px solid var(--line); border-radius: 24px; background: linear-gradient(160deg, rgba(138, 118, 216, 0.16), rgba(212, 175, 106, 0.08)); }
  .cta-title { font-size: 1.5rem; margin: 0 0 14px; }
  .cta-text { color: var(--muted); margin: 0 0 26px; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; }

  @media (max-width: 860px) {
    .profile { grid-template-columns: 1fr; gap: 32px; }
    .profile-photo { max-width: 320px; margin-inline: auto; }
    .profile-name { text-align: center; }
    .profile-role { text-align: center; }
  }
</style>
