---
import Layout from '../layouts/Layout.astro';
import SnsIcons from '../components/SnsIcons.astro';
import { SNS_LINKS, CONTACT_EMAIL, LINE_BUSINESS_URL, LINE_FORTUNE_URL } from '../consts';
import { withBase } from '../lib/url';

const hasSns = SNS_LINKS.some((s) => s.url);

// 公式LINEの窓口（ご用件で分かれています）
const lines = [
  {
    label: '占いのご相談',
    sub: 'Fortune',
    url: LINE_FORTUNE_URL,
    text: '占いコミュニティ fortunelabo への参加、個人鑑定（チャネリング／ルノルマン）のご依頼はこちらから。',
    items: ['コミュニティに参加したい', '定例会について知りたい', '個人鑑定をお願いしたい'],
    href: withBase('/service/community'),
    hrefLabel: '占いコミュニティを見る',
  },
  {
    label: 'お仕事のご相談',
    sub: 'Work',
    url: LINE_BUSINESS_URL,
    text: 'テレアポ事業・営業代行事業へのご応募、働き方のご相談はこちらから。',
    items: ['在宅の仕事を始めたい', '働き方や報酬を詳しく聞きたい', '未経験でもできるか相談したい'],
    href: withBase('/service'),
    hrefLabel: '事業内容を見る',
  },
];

const flow = [
  { step: 'STEP 01', title: '友だち追加', text: 'ご用件に合うボタンから、公式LINEを友だち追加してください。' },
  { step: 'STEP 02', title: 'メッセージ送信', text: 'お名前と、気になっていることを一言お送りください。' },
  { step: 'STEP 03', title: 'ご返信', text: '内容を確認し、通常2〜3日以内にご返信します。' },
];
---

<Layout
  title="お問い合わせ"
  description="占いコミュニティ・個人鑑定、テレアポ事業・営業代行事業へのご相談は公式LINEから承っています。"
>
  <section class="section">
    <div class="container narrow">
      <div class="text-center reveal">
        <span class="section-label">Contact</span>
        <h1 class="section-title">お問い合わせ</h1>
        <p class="section-lead">
          ご相談・お申し込みは<strong>公式LINE</strong>で承っています。<br />
          ご用件に合わせて、下のボタンからお友だち追加してください。
        </p>
      </div>

      <div class="line-cards">
        {lines.map((l) => (
          <article class="line-card reveal">
            <p class="line-sub">{l.sub}</p>
            <h2 class="line-label">{l.label}</h2>
            <p class="line-text">{l.text}</p>
            <ul class="line-items">
              {l.items.map((i) => <li>{i}</li>)}
            </ul>
            <a class="btn btn-line" href={l.url} target="_blank" rel="noopener noreferrer">
              公式LINEを追加する
            </a>
            <a class="line-more" href={l.href}>{l.hrefLabel} →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <div class="text-center reveal">
        <span class="section-label">Flow</span>
        <h2 class="section-title">ご連絡の流れ</h2>
      </div>
      <div class="flow-grid">
        {flow.map((f) => (
          <div class="card flow-card reveal">
            <span class="flow-step">{f.step}</span>
            <h3 class="flow-title">{f.title}</h3>
            <p class="flow-text">{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container narrow">
      <div class="card note-box reveal">
        <p class="note-title">ご連絡の前に</p>
        <ul class="note-list">
          <li>いただいたご相談には、通常2〜3日以内にご返信しています。</li>
          <li>返信が届かない場合は、LINEの通知設定をご確認のうえ、もう一度お送りください。</li>
          <li>鑑定は医療・法律・投資の判断に代わるものではありません。</li>
        </ul>
      </div>

      {hasSns && (
        <div class="sns-box reveal">
          <p class="sns-label">SNSのDMからでもご連絡いただけます</p>
          <SnsIcons size={22} gap={16} variant="circle" class="sns-center" />
        </div>
      )}

      {CONTACT_EMAIL && (
        <p class="mail reveal">
          メールでのご連絡：<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        </p>
      )}
    </div>
  </section>
</Layout>

<style>
  .section-lead strong { color: var(--accent-deep); font-weight: 700; }

  .line-cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; margin-top: 44px; }
  .line-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 36px 30px 30px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 20px;
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .line-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .line-sub { font-family: var(--font-serif); font-size: 0.7rem; letter-spacing: 0.26em; color: var(--accent); margin: 0 0 8px; }
  .line-label { font-size: 1.28rem; margin: 0 0 14px; }
  .line-text { color: var(--muted); font-size: 0.9rem; margin: 0 0 20px; }

  .line-items { list-style: none; margin: 0 0 26px; padding: 0; display: grid; gap: 9px; width: 100%; }
  .line-items li {
    position: relative;
    padding: 9px 14px 9px 30px;
    background: var(--panel-strong);
    border-radius: 10px;
    font-size: 0.88rem;
    text-align: left;
  }
  .line-items li::before {
    content: '';
    position: absolute;
    left: 14px;
    top: 1.15em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .line-card .btn { width: 100%; }
  .line-more { margin-top: 16px; font-size: 0.85rem; text-decoration: none; }
  .line-more:hover { text-decoration: underline; text-underline-offset: 4px; }

  .flow-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-top: 40px; }
  .flow-step { font-family: var(--font-serif); font-size: 0.7rem; letter-spacing: 0.24em; color: var(--accent); }
  .flow-title { font-size: 1.05rem; margin: 10px 0; }
  .flow-text { color: var(--muted); font-size: 0.9rem; margin: 0; }

  .note-box { margin-top: 8px; }
  .note-title { font-family: var(--font-serif); font-size: 1.02rem; margin: 0 0 14px; }
  .note-list { margin: 0; padding-left: 1.2em; color: var(--muted); font-size: 0.9rem; }
  .note-list li { margin-bottom: 8px; }
  .note-list li::marker { color: var(--accent); }

  .sns-box { margin-top: 40px; text-align: center; }
  .sns-label { font-size: 0.88rem; color: var(--muted); margin: 0 0 18px; }
  .sns-center { justify-content: center; }

  .mail { margin-top: 26px; text-align: center; font-size: 0.9rem; color: var(--muted); }

  @media (max-width: 760px) {
    .line-cards { grid-template-columns: 1fr; }
  }
</style>
