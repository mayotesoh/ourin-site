---
import Layout from '../layouts/Layout.astro';
import SnsIcons from '../components/SnsIcons.astro';
import { GAS_CONTACT_URL, CONTACT_TOPICS, TIME_SLOTS, SNS_LINKS, CONTACT_EMAIL } from '../consts';

const ready = GAS_CONTACT_URL.trim() !== '';
const hasSns = SNS_LINKS.some((s) => s.url);

// 連絡手段の案内文（SNS・メールの設定状況に応じて文面を変えます）
const contactWays = [hasSns ? 'SNSのDM' : '', CONTACT_EMAIL ? 'メール' : ''].filter(Boolean);
const contactNote =
  contactWays.length > 0
    ? `お急ぎの場合は${contactWays.join('、または')}よりご連絡ください。`
    : '準備が整いしだい、こちらのページからお申し込みいただけるようになります。';
---

<Layout
  title="お問い合わせ"
  description="占いコミュニティ・テレアポ事業・営業代行事業へのご参加、個人鑑定のご依頼はこちらから。内容を確認のうえ折り返しご連絡いたします。"
>
  <section class="section">
    <div class="container narrow">
      <div class="text-center reveal">
        <span class="section-label">Contact</span>
        <h1 class="section-title">お問い合わせ</h1>
        <p class="section-lead">
          各事業へのご参加・ご相談はお気軽にどうぞ。<br />
          内容を確認のうえ、折り返しご連絡いたします（通常2〜3日以内）。
        </p>
      </div>

      {!ready && (
        <div class="card notice reveal">
          <p class="notice-title">✧ お問い合わせフォームは現在準備中です</p>
          <p>
            送信先の設定（GASウェブアプリURL）が未登録のため、送信ボタンは無効になっています。<br />
            {contactNote}
            {CONTACT_EMAIL && <> （<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>）</>}
          </p>
          {hasSns && <div class="notice-sns"><SnsIcons size={20} gap={14} variant="circle" /></div>}
        </div>
      )}

      <form id="contact-form" class="card form reveal" novalidate>
        <div class="field">
          <label for="name">お名前 <span class="req">必須</span></label>
          <input type="text" id="name" name="name" autocomplete="name" placeholder="山田 花子" required />
        </div>

        <div class="field">
          <label for="email">メールアドレス <span class="req">必須</span></label>
          <input type="email" id="email" name="email" autocomplete="email" placeholder="example@mail.com" required />
          <p class="hint">ご連絡はこちらにお送りします。</p>
        </div>

        <div class="field">
          <label for="contact">SNSアカウント・電話番号など（任意）</label>
          <input type="text" id="contact" name="contact" placeholder="@your_account / 090-0000-0000" />
        </div>

        <div class="field">
          <label for="topic">ご用件 <span class="req">必須</span></label>
          <select id="topic" name="topic" required>
            <option value="" disabled selected>選択してください</option>
            {CONTACT_TOPICS.map((t) => <option value={t}>{t}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="style">ご希望の形式（任意）</label>
          <div class="radio-row">
            <label class="radio"><input type="radio" name="style" value="オンライン" /><span>オンライン</span></label>
            <label class="radio"><input type="radio" name="style" value="対面" /><span>対面</span></label>
            <label class="radio"><input type="radio" name="style" value="どちらでも" /><span>どちらでも</span></label>
          </div>
        </div>

        <fieldset class="field group">
          <legend>ご希望の日時（任意）</legend>
          <p class="hint">面談・鑑定をご希望の場合はご記入ください。</p>
          <div class="datetime">
            <input type="date" id="date1" name="date1" />
            <select id="time1" name="time1">
              <option value="" selected>時間</option>
              {TIME_SLOTS.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
        </fieldset>

        <fieldset class="field group">
          <legend>第2希望の日時（任意）</legend>
          <div class="datetime">
            <input type="date" id="date2" name="date2" />
            <select id="time2" name="time2">
              <option value="" selected>時間</option>
              {TIME_SLOTS.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
        </fieldset>

        <div class="field">
          <label for="message">お問い合わせ内容 <span class="req">必須</span></label>
          <textarea
            id="message"
            name="message"
            rows="6"
            placeholder="現在のお仕事の状況や、気になっていることをご自由にお書きください。&#10;（例）占い師として活動を始めたいけれど、何から手をつければいいか分からない。"
            required></textarea>
        </div>

        <label class="agree">
          <input type="checkbox" id="agree" name="agree" required />
          <span>ご記入いただいた内容を、ご連絡・ご案内の目的で利用することに同意します。</span>
        </label>

        <button type="submit" id="submit-btn" class="btn btn-primary submit" disabled={!ready}>
          {ready ? 'この内容で送信する' : '準備中'}
        </button>

        <p id="result" class="result" role="status" aria-live="polite"></p>
      </form>

      <div class="after reveal">
        <h2 class="after-title">送信後の流れ</h2>
        <ol class="after-list">
          <li>フォーム送信後、自動で受付が完了します（この時点ではまだ確定ではありません）。</li>
          <li>内容を確認し、担当より折り返しご連絡をお送りします。</li>
          <li>ご希望に応じて、オンラインまたは対面で個別にお話しします。</li>
        </ol>
        <p class="after-note">
          数日経っても返信が届かない場合は、迷惑メールフォルダをご確認のうえ、{hasSns ? 'SNSのDM' : 'お手数ですが再度フォーム'}よりご連絡ください。
        </p>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ GAS_CONTACT_URL }}>
  (function () {
    var form = document.getElementById('contact-form');
    var btn = document.getElementById('submit-btn');
    var result = document.getElementById('result');
    if (!form || !btn) return;

    // 過去日を選べないようにする
    var today = new Date();
    var min =
      today.getFullYear() +
      '-' +
      String(today.getMonth() + 1).padStart(2, '0') +
      '-' +
      String(today.getDate()).padStart(2, '0');
    ['date1', 'date2'].forEach(function (id) {
      var el = document.getElementById(id);
      if (el) el.min = min;
    });

    function show(message, type) {
      result.textContent = message;
      result.className = 'result ' + (type || '');
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (!GAS_CONTACT_URL) {
        show('送信先が未設定です。SNSまたはメールよりご連絡ください。', 'error');
        return;
      }
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      var data = Object.fromEntries(new FormData(form).entries());
      data.agree = form.querySelector('#agree').checked ? '同意' : '';
      data.pageUrl = location.href;

      btn.disabled = true;
      show('送信しています…', '');

      try {
        // CORSプリフライトを避けるため text/plain で送信（GAS側でJSON.parse）
        var res = await fetch(GAS_CONTACT_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(data),
        });
        var json = await res.json().catch(function () { return { ok: res.ok }; });

        if (json && json.ok) {
          form.reset();
          show('お問い合わせを受け付けました。折り返しご連絡いたしますので、少々お待ちください。', 'success');
        } else {
          show((json && json.message) || '送信に失敗しました。時間をおいて再度お試しください。', 'error');
          btn.disabled = false;
        }
      } catch (err) {
        show('通信に失敗しました。電波状況をご確認のうえ、もう一度お試しください。', 'error');
        btn.disabled = false;
      }
    });
  })();
</script>

<style>
  .notice { margin-top: 40px; border-color: var(--line); background: var(--accent-pale); }
  .notice-title { font-family: var(--font-serif); color: var(--accent-deep); margin: 0 0 10px; }
  .notice p { margin: 0; color: var(--muted); font-size: 0.92rem; }
  .notice-sns { margin-top: 18px; display: flex; justify-content: center; }

  .form { margin-top: 40px; display: grid; gap: 22px; }
  .field { display: grid; gap: 8px; }
  .field label,
  .field legend { font-size: 0.9rem; letter-spacing: 0.06em; }
  .group { border: 0; margin: 0; padding: 0; }
  .req { font-size: 0.66rem; color: #ffffff; background: var(--accent); border-radius: 4px; padding: 2px 7px; margin-left: 8px; letter-spacing: 0.08em; vertical-align: 2px; }
  .hint { margin: 0; font-size: 0.78rem; color: var(--muted); }

  input[type='text'],
  input[type='email'],
  input[type='date'],
  select,
  textarea {
    width: 100%;
    padding: 13px 16px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--field-bg);
    color: var(--text);
    font-family: inherit;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  input::placeholder,
  textarea::placeholder { color: var(--muted-soft); }
  input:focus,
  select:focus,
  textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(14, 165, 120, 0.14); }
  select option { background: #ffffff; color: var(--text); }
  textarea { resize: vertical; line-height: 1.8; }
  input[type='date'] { color-scheme: light; }

  .datetime { display: grid; grid-template-columns: 1.4fr 1fr; gap: 12px; }

  .radio-row { display: flex; flex-wrap: wrap; gap: 10px; }
  .radio { display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border: 1px solid var(--border); border-radius: 999px; cursor: pointer; background: var(--panel); font-size: 0.9rem; transition: border-color 0.2s ease, background 0.2s ease; }
  .radio:hover { border-color: var(--line); }
  .radio input { accent-color: #0ea578; }
  .radio:has(input:checked) { border-color: var(--accent); background: var(--accent-pale); }

  .agree { display: flex; align-items: flex-start; gap: 10px; font-size: 0.88rem; color: var(--muted); line-height: 1.7; }
  .agree input { margin-top: 6px; accent-color: #0ea578; }

  .submit { width: 100%; margin-top: 6px; border: 0; }
  .submit:disabled { opacity: 0.45; cursor: not-allowed; box-shadow: none; transform: none; }

  .result { margin: 0; min-height: 1.4em; text-align: center; font-size: 0.9rem; }
  .result.success { color: #1f8a54; }
  .result.error { color: #c0392b; }

  .after { margin-top: 56px; }
  .after-title { font-size: 1.15rem; margin: 0 0 18px; }
  .after-list { margin: 0; padding-left: 1.3em; color: var(--muted); font-size: 0.92rem; }
  .after-list li { margin-bottom: 10px; }
  .after-list li::marker { color: var(--accent); }
  .after-note { margin-top: 18px; font-size: 0.82rem; color: var(--muted-soft); }

  @media (max-width: 560px) {
    .datetime { grid-template-columns: 1fr; }
  }
</style>
