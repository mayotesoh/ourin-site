---
import Layout from '../../layouts/Layout.astro';
import { SERVICES } from '../../consts';
import { withBase } from '../../lib/url';

const contact = withBase('/contact');
---

<Layout
  title="事業内容"
  description="占いコミュニティ（Branch Cafe）・テレアポ事業・営業代行事業。3つの事業内容と、それぞれの働き方・特徴をご紹介します。"
>
  <section class="section">
    <div class="container">
      <div class="text-center reveal">
        <span class="section-label">Service</span>
        <h1 class="section-title">事業内容</h1>
        <p class="section-lead">
          「時間も収入も、自分でコントロールできる働き方」を実践しながら、<br />
          同じ想いを持つ女性たちが一歩踏み出せる環境をつくっています。
        </p>
      </div>

      <div class="service-list">
        {SERVICES.map((s) => (
          <article class="service-item reveal">
            <div class="item-head">
              <p class="item-no">
                <span class="no">{s.no}</span>
                <span class="en">{s.en}</span>
              </p>
              <h2 class="item-name">
                <a href={withBase(`/service/${s.id}`)}>{s.name}</a>
              </h2>
              <p class="item-lead">{s.lead}</p>
            </div>

            <p class="item-summary">{s.summary}</p>

            <div class="item-grid">
              <div>
                <h3 class="col-title">特徴</h3>
                <ul class="check-list">
                  {s.points.slice(0, 4).map((p) => <li>{p}</li>)}
                </ul>
              </div>
              <div>
                <h3 class="col-title">こんな方におすすめ</h3>
                <ul class="dot-list">
                  {s.target.map((t) => <li>{t}</li>)}
                </ul>
              </div>
            </div>

            <div class="item-actions">
              <a href={withBase(`/service/${s.id}`)} class="btn btn-primary">この事業をくわしく見る</a>
              <a href={contact} class="btn btn-ghost">相談する</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta reveal">
        <span class="section-label">Contact</span>
        <h2 class="cta-title">まずはお気軽にご相談ください</h2>
        <p class="cta-text">
          「どれが自分に合うかわからない」という状態でも大丈夫です。<br />
          今の状況をうかがったうえで、いちばん合う関わり方をご提案します。
        </p>
        <a href={contact} class="btn btn-primary">お問い合わせフォームへ</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .service-list { display: grid; gap: 30px; margin-top: 48px; }
  .service-item {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 22px;
    box-shadow: var(--shadow-sm);
    padding: 40px 44px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .service-item:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }

  .item-head { border-bottom: 1px solid var(--border); padding-bottom: 20px; margin-bottom: 24px; }
  .item-no { display: flex; align-items: baseline; gap: 14px; margin: 0 0 10px; }
  .item-no .no { font-family: var(--font-serif); font-size: 1.5rem; color: var(--accent); letter-spacing: 0.08em; }
  .item-no .en { font-family: var(--font-serif); font-size: 0.7rem; letter-spacing: 0.24em; color: var(--muted); text-transform: uppercase; }
  .item-name { font-size: clamp(1.25rem, 3.2vw, 1.55rem); margin: 0 0 10px; }
  .item-name a { color: var(--text); text-decoration: none; }
  .item-name a:hover { color: var(--accent-deep); }
  .item-lead { font-family: var(--font-serif); font-size: 1.02rem; color: var(--accent-deep); margin: 0; }
  .item-summary { color: var(--muted); font-size: 0.95rem; margin: 0 0 26px; }

  .item-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 32px; }
  .col-title {
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    color: var(--accent-deep);
    margin: 0 0 14px;
    padding-left: 12px;
    border-left: 3px solid var(--accent);
  }

  .check-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .check-list li { position: relative; padding-left: 26px; font-size: 0.9rem; }
  .check-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 3px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--accent-pale);
    color: var(--accent-deep);
    font-size: 0.7rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dot-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .dot-list li { position: relative; padding: 8px 14px 8px 28px; background: var(--panel-strong); border-radius: 10px; font-size: 0.88rem; }
  .dot-list li::before { content: ''; position: absolute; left: 13px; top: 1.1em; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }

  .item-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 30px; }

  .cta {
    text-align: center;
    padding: 56px 28px;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: linear-gradient(160deg, rgba(111, 224, 180, 0.3), rgba(255, 255, 255, 0.9));
    box-shadow: var(--shadow-sm);
  }
  .cta-title { font-size: clamp(1.3rem, 4vw, 1.8rem); margin: 0 0 16px; }
  .cta-text { color: var(--muted); margin: 0 0 28px; }

  @media (max-width: 860px) {
    .service-item { padding: 30px 24px; }
    .item-grid { grid-template-columns: 1fr; gap: 26px; }
    .item-actions .btn { flex: 1 1 auto; text-align: center; }
  }
</style>
