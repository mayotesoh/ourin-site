---
import Layout from '../../layouts/Layout.astro';
import DetailSections from '../../components/DetailSections.astro';
import { SERVICES } from '../../consts';
import { withBase } from '../../lib/url';

export function getStaticPaths() {
  return SERVICES.map((service, i) => ({
    params: { id: service.id },
    props: {
      service,
      prev: SERVICES[i - 1] ?? null,
      next: SERVICES[i + 1] ?? null,
    },
  }));
}

const { service, prev, next } = Astro.props;
---

<Layout title={service.name} description={service.summary}>
  <!-- ページヘッダー -->
  <section class="detail-hero">
    <div class="container">
      <nav class="breadcrumb reveal" aria-label="パンくず">
        <a href={withBase('/')}>ホーム</a>
        <span>›</span>
        <a href={withBase('/service')}>事業内容</a>
        <span>›</span>
        <span class="current">{service.name}</span>
      </nav>

      <div class="hero-head reveal">
        <p class="hero-no">
          <span class="no">{service.no}</span>
          <span class="en">{service.en}</span>
        </p>
        <h1 class="hero-name">{service.name}</h1>
        <p class="hero-lead">{service.lead}</p>
      </div>
    </div>
  </section>

  <!-- 写真 -->
  {
    service.image && (
      <section class="section-sm photo-section">
        <div class="container">
          <figure class="photo reveal">
            <img src={withBase(service.image)} alt={service.imageAlt ?? service.name} width="1400" height="933" />
          </figure>
        </div>
      </section>
    )
  }

  <!-- 概要・特徴・対象 -->
  <section class="section-sm">
    <div class="container">
      <div class="overview reveal">
        <p class="overview-text">{service.detailLead ?? service.summary}</p>

        <div class="overview-grid">
          <div>
            <h2 class="col-title">特徴</h2>
            <ul class="check-list">
              {service.points.map((p) => <li>{p}</li>)}
            </ul>
          </div>
          <div>
            <h2 class="col-title">こんな方におすすめ</h2>
            <ul class="dot-list">
              {service.target.map((t) => <li>{t}</li>)}
            </ul>
            {service.note && <p class="note">{service.note}</p>}
          </div>
        </div>
      </div>

      {service.links && service.links.length > 0 && (
        <div class="links reveal">
          {service.links.map((l) => (
            <a
              class:list={['link-card', { primary: l.primary }]}
              href={l.url}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="link-label">{l.label}</span>
              <span class="link-arrow">↗</span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- 稼働プラン -->
  {
    service.plans && service.plans.length > 0 && (
      <section class="section-sm">
        <div class="container">
          <div class="text-center reveal">
            <span class="section-label">Plan</span>
            <h2 class="section-title">稼働プラン</h2>
          </div>
          <div class="plan-grid">
            {service.plans.map((plan) => (
              <article class="card plan-card reveal">
                <h3 class="plan-name">{plan.name}</h3>
                <p class="plan-price">{plan.price}</p>
                <ul class="plan-items">
                  {plan.items.map((it) => <li>{it}</li>)}
                </ul>
              </article>
            ))}
          </div>
          {service.planNote && <p class="small-note reveal">{service.planNote}</p>}
        </div>
      </section>
    )
  }

  <!-- 取り扱い案件 -->
  {
    service.cases && service.cases.length > 0 && (
      <section class="section-sm">
        <div class="container">
          <div class="text-center reveal">
            <span class="section-label">Projects</span>
            <h2 class="section-title">取り扱い案件</h2>
          </div>
          <ul class="case-list reveal">
            {service.cases.map((c) => (
              <li class="case-item">
                <span class="case-label">{c.label}</span>
                <span class="case-work">{c.work}</span>
                {c.note && <span class="case-note">{c.note}</span>}
              </li>
            ))}
          </ul>
          {service.caseNote && <p class="small-note reveal">{service.caseNote}</p>}
        </div>
      </section>
    )
  }

  <!-- 追記していくセクション（内容が入ると自動で表示されます） -->
  <DetailSections
    blocks={service.blocks}
    flow={service.flow}
    faq={service.faq}
    voices={service.voices}
    flowTitle={service.id === 'community' ? '参加までの流れ' : 'お仕事開始までの流れ'}
  />

  <!-- CTA -->
  <section class="section">
    <div class="container">
      <div class="cta reveal">
        <span class="section-label">Contact</span>
        <h2 class="cta-title">{service.name}について相談する</h2>
        <p class="cta-text">
          気になることがあれば、お気軽にご相談ください。<br />
          公式LINEからご連絡いただけます。
        </p>
        <div class="cta-actions">
          {service.lineUrl && (
            <a href={service.lineUrl} class="btn btn-line" target="_blank" rel="noopener noreferrer">
              公式LINEで相談する
            </a>
          )}
        </div>
      </div>

      <!-- 他の事業へ -->
      <nav class="sibling-nav reveal">
        {prev ? (
          <a class="sibling prev" href={withBase(`/service/${prev.id}`)}>
            <span>← {prev.no}</span>
            <strong>{prev.name}</strong>
          </a>
        ) : <span />}
        {next ? (
          <a class="sibling next" href={withBase(`/service/${next.id}`)}>
            <span>{next.no} →</span>
            <strong>{next.name}</strong>
          </a>
        ) : <span />}
      </nav>

      <p class="back-link text-center">
        <a href={withBase('/service')}>事業内容の一覧へ戻る</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .detail-hero { padding: 40px 0 8px; }
  .breadcrumb { display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.78rem; color: var(--muted); margin-bottom: 34px; }
  .breadcrumb a { color: var(--muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent-deep); text-decoration: underline; text-underline-offset: 4px; }
  .breadcrumb .current { color: var(--accent-deep); }

  .hero-head { text-align: center; }
  .hero-no { display: flex; align-items: baseline; justify-content: center; gap: 14px; margin: 0 0 12px; }
  .hero-no .no { font-family: var(--font-serif); font-size: 1.7rem; color: var(--accent); letter-spacing: 0.08em; }
  .hero-no .en { font-family: var(--font-serif); font-size: 0.72rem; letter-spacing: 0.24em; color: var(--muted); text-transform: uppercase; }
  .hero-name { font-size: clamp(1.4rem, 4vw, 2rem); margin: 0 0 14px; }
  .hero-lead { font-family: var(--font-serif); font-size: clamp(1rem, 2.6vw, 1.15rem); color: var(--accent-deep); margin: 0; }

  .overview {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 22px;
    box-shadow: var(--shadow-sm);
    padding: 42px 46px;
  }
  .overview-text { color: var(--muted); margin: 0 0 32px; }
  .overview-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 36px; }
  .col-title {
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    color: var(--accent-deep);
    margin: 0 0 16px;
    padding-left: 12px;
    border-left: 3px solid var(--accent);
  }

  .check-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .check-list li { position: relative; padding-left: 28px; font-size: 0.94rem; }
  .check-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 4px;
    width: 19px;
    height: 19px;
    border-radius: 50%;
    background: var(--accent-pale);
    color: var(--accent-deep);
    font-size: 0.72rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dot-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .dot-list li { position: relative; padding: 10px 16px 10px 30px; background: var(--panel-strong); border-radius: 10px; font-size: 0.9rem; }
  .dot-list li::before { content: ''; position: absolute; left: 14px; top: 1.15em; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }

  .note { margin: 20px 0 0; padding: 14px 18px; background: var(--accent-pale); border-radius: 10px; font-size: 0.85rem; color: var(--accent-deep); line-height: 1.8; }

  .cta {
    text-align: center;
    padding: 52px 28px;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: linear-gradient(160deg, rgba(111, 224, 180, 0.3), rgba(255, 255, 255, 0.9));
    box-shadow: var(--shadow-sm);
  }
  .cta-title { font-size: clamp(1.2rem, 3.6vw, 1.6rem); margin: 0 0 16px; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; }

  /* 写真 */
  .photo-section { padding-top: 34px; }
  .photo { margin: 0; }
  .photo img {
    display: block;
    width: 100%;
    height: auto; /* 写真の上下が切れないように、元の比率のまま表示する */
    border-radius: 22px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md);
  }

  /* 外部リンク */
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 30px; }
  .link-card {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 22px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: var(--accent-deep);
    font-size: 0.9rem;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .link-card:hover { transform: translateY(-2px); border-color: var(--line); }
  .link-arrow { font-size: 0.85rem; }

  /* 目立たせる外部リンク（公式サイトなど） */
  .link-card.primary {
    padding: 18px 34px;
    font-family: var(--font-serif);
    font-size: 1.02rem;
    letter-spacing: 0.08em;
    color: #ffffff;
    background: linear-gradient(120deg, #0fb37f, #35d3a0 55%, #0b8f66);
    border-color: transparent;
    box-shadow: 0 10px 24px rgba(14, 165, 120, 0.3);
  }
  .link-card.primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px rgba(14, 165, 120, 0.38);
    filter: brightness(1.04);
  }
  .link-card.primary .link-arrow { font-size: 0.95rem; }

  /* プラン */
  .plan-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 22px; margin-top: 40px; }
  .plan-card { text-align: center; }
  .plan-name { font-size: 1.05rem; margin: 0 0 12px; }
  .plan-price { font-family: var(--font-serif); font-size: 1.5rem; color: var(--accent-deep); margin: 0 0 18px; }
  .plan-items { list-style: none; margin: 0; padding: 18px 0 0; border-top: 1px solid var(--border); display: grid; gap: 8px; }
  .plan-items li { font-size: 0.9rem; color: var(--muted); }

  /* 案件一覧 */
  .case-list { list-style: none; margin: 40px 0 0; padding: 0; display: grid; gap: 12px; }
  .case-item {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 16px;
    align-items: center;
    padding: 16px 22px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: var(--shadow-sm);
  }
  .case-label { font-size: 0.95rem; }
  .case-work { font-size: 0.85rem; color: var(--accent-deep); background: var(--accent-pale); border-radius: 999px; padding: 4px 14px; white-space: nowrap; }
  .case-note { font-size: 0.75rem; color: var(--muted-soft); }

  .small-note { margin: 22px 0 0; font-size: 0.8rem; color: var(--muted-soft); text-align: center; }
  .cta-text { color: var(--muted); margin: 0 0 28px; }

  .sibling-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 40px; }
  .sibling {
    display: block;
    padding: 18px 22px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: var(--text);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .sibling:hover { transform: translateY(-2px); border-color: var(--line); }
  .sibling.next { text-align: right; }
  .sibling span { display: block; font-size: 0.74rem; letter-spacing: 0.14em; color: var(--accent); margin-bottom: 6px; }
  .sibling strong { font-weight: 500; font-size: 0.92rem; }

  .back-link { margin-top: 30px; font-size: 0.88rem; }

  @media (max-width: 860px) {
    .overview { padding: 30px 24px; }
    .case-item { grid-template-columns: 1fr; gap: 8px; }
    .case-work { justify-self: start; }
    .overview-grid { grid-template-columns: 1fr; gap: 30px; }
    .sibling-nav { grid-template-columns: 1fr; }
    .sibling.next { text-align: left; }
  }
</style>
