---
import Layout from '../layouts/Layout.astro';
import { queryDatabase, getTitle, getText, getNumber, getStatus } from '../lib/notion';
import { withBase } from '../lib/url';

// Notion の「メニュー」DBがあればそこから読み込み、無ければ下の既定メニューを表示します。
const menuDbId = import.meta.env.NOTION_MENU_ID;
const menuPages = await queryDatabase(menuDbId, {});

const notionMenus = menuPages
  .filter((p: any) => {
    const s = getStatus(p);
    return s === '' || s === '公開' || s === 'Published';
  })
  .map((p: any) => ({
    name: getTitle(p, ['メニュー名', 'タイトル', '名前', 'Name']),
    duration: getText(p, ['時間', '所要時間']) || (getNumber(p, ['時間', '所要時間']) ? `${getNumber(p, ['時間', '所要時間'])}分` : ''),
    price: getNumber(p, ['料金', '価格', 'Price']),
    priceText: getText(p, ['料金テキスト', '料金表記']),
    desc: getText(p, ['説明', '内容', 'Description']),
    order: getNumber(p, ['並び順', '順番']) ?? 99,
  }))
  .sort((a, b) => a.order - b.order);

// ★既定メニュー（Notion未設定のときに表示。料金は自由に書き換えてください）
const defaultMenus = [
  {
    name: 'チャネリングセッション',
    duration: '60分',
    price: null as number | null,
    priceText: '要確認',
    desc: 'いま必要なメッセージを受け取り、お伝えします。テーマは恋愛・仕事・人間関係・これからの方向性など、なんでもかまいません。',
    order: 1,
  },
  {
    name: 'ルノルマンカードリーディング',
    duration: '40分',
    price: null as number | null,
    priceText: '要確認',
    desc: '36枚のカードで、近い未来の流れと具体的な状況を読み解きます。「どちらを選ぶか」といったご相談にも向いています。',
    order: 2,
  },
  {
    name: 'チャネリング＋ルノルマン',
    duration: '90分',
    price: null as number | null,
    priceText: '要確認',
    desc: '見えない領域からのメッセージと、現実の流れの両面からじっくり読み解くフルセッション。しっかり整理したい方におすすめです。',
    order: 3,
  },
];

const menus = notionMenus.length > 0 ? notionMenus : defaultMenus;

const flow = [
  { step: 'STEP 01', title: 'ご予約', text: '予約フォームからご希望の日時とメニューをお送りください。' },
  { step: 'STEP 02', title: '日程の確定', text: '凰凛より折り返しご連絡し、日時を確定します。' },
  { step: 'STEP 03', title: '鑑定', text: '対面またはオンラインで、じっくりお話をうかがいながら鑑定します。' },
  { step: 'STEP 04', title: 'アフターフォロー', text: '鑑定後に気になったことは、お気軽にご相談ください。' },
];

const notes = [
  '医療・法律・投資に関する判断そのものを行うものではありません。',
  '生死や余命など、お答えできないご相談もございます。',
  'キャンセルは前日までにご連絡いただけますと幸いです。',
];
---

<Layout title="占術メニュー" description="チャネリング・ルノルマンカードの鑑定メニューと、ご予約から鑑定までの流れをご案内します。">
  <section class="section">
    <div class="container">
      <div class="text-center reveal">
        <span class="section-label">Menu</span>
        <h1 class="section-title">占術メニュー</h1>
        <p class="section-lead">
          チャネリングとルノルマンカード。ご相談内容に合わせて、いちばん届く形でお伝えします。<br />
          迷われる場合は「その他・ご相談」からお申し込みいただければ、一緒に選びます。
        </p>
      </div>

      <div class="menu-list">
        {menus.map((m, i) => (
          <article class="card menu-card reveal">
            <div class="menu-head">
              <span class="menu-no">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h2 class="menu-name">{m.name}</h2>
                {m.duration && <p class="menu-duration">所要時間：{m.duration}</p>}
              </div>
              <p class="menu-price">
                {m.price != null ? `¥${m.price.toLocaleString('ja-JP')}` : m.priceText || '要確認'}
              </p>
            </div>
            {m.desc && <p class="menu-desc">{m.desc}</p>}
            <a class="menu-link" href={withBase("/reserve")}>このメニューで予約する →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <div class="text-center reveal">
        <span class="section-label">Flow</span>
        <h2 class="section-title">ご予約から鑑定までの流れ</h2>
      </div>
      <div class="flow-grid">
        {flow.map((f) => (
          <div class="card flow-card reveal">
            <span class="flow-step">{f.step}</span>
            <h3 class="flow-title">{f.title}</h3>
            <p class="flow-text">{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="card notes reveal">
        <h2 class="notes-title">ご鑑定の前に</h2>
        <ul>
          {notes.map((n) => <li>{n}</li>)}
        </ul>
      </div>
      <div class="text-center" style="margin-top: 40px;">
        <a href={withBase("/reserve")} class="btn btn-primary">予約フォームへ進む</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .menu-list { display: grid; gap: 22px; margin-top: 48px; }
  .menu-card { transition: transform 0.3s ease, border-color 0.3s ease; }
  .menu-card:hover { transform: translateY(-3px); border-color: var(--line); }
  .menu-head { display: grid; grid-template-columns: auto 1fr auto; gap: 18px; align-items: center; }
  .menu-no { font-family: var(--font-serif); font-size: 1.1rem; letter-spacing: 0.16em; color: var(--gold); }
  .menu-name { font-size: 1.25rem; margin: 0 0 4px; }
  .menu-duration { font-size: 0.8rem; color: var(--muted); margin: 0; letter-spacing: 0.08em; }
  .menu-price { font-family: var(--font-serif); font-size: 1.25rem; color: var(--gold-bright); margin: 0; white-space: nowrap; }
  .menu-desc { color: var(--muted); font-size: 0.95rem; margin: 18px 0 20px; }
  .menu-link { font-size: 0.9rem; text-decoration: none; letter-spacing: 0.06em; }
  .menu-link:hover { text-decoration: underline; text-underline-offset: 5px; }

  .flow-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-top: 44px; }
  .flow-step { font-family: var(--font-serif); font-size: 0.7rem; letter-spacing: 0.24em; color: var(--gold); }
  .flow-title { font-size: 1.05rem; margin: 10px 0 10px; }
  .flow-text { color: var(--muted); font-size: 0.9rem; margin: 0; }

  .notes-title { font-size: 1.15rem; margin: 0 0 16px; }
  .notes ul { margin: 0; padding-left: 1.2em; color: var(--muted); font-size: 0.92rem; }
  .notes li { margin-bottom: 8px; }
  .notes li::marker { color: var(--gold); }

  @media (max-width: 640px) {
    .menu-head { grid-template-columns: auto 1fr; row-gap: 12px; }
    .menu-price { grid-column: 1 / -1; text-align: right; }
  }
</style>
