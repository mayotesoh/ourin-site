---
import Layout from '../layouts/Layout.astro';
import SnsIcons from '../components/SnsIcons.astro';
import { GAS_RESERVE_URL, RESERVE_MENUS, RESERVE_TIME_SLOTS, SNS_LINKS, CONTACT_EMAIL } from '../consts';

const ready = GAS_RESERVE_URL.trim() !== '';
const hasSns = SNS_LINKS.some((s) => s.url);

// 連絡手段の案内文（SNS・メールの設定状況に応じて文面を変えます）
const contactWays = [hasSns ? 'SNSのDM' : '', CONTACT_EMAIL ? 'メール' : ''].filter(Boolean);
const contactNote =
  contactWays.length > 0
    ? `お急ぎの場合は${contactWays.join('、または')}よりご連絡ください。`
    : '準備が整いしだい、こちらのページからお申し込みいただけるようになります。';
---

<Layout
  title="ご予約"
  description="チャネリング・ルノルマン鑑定のご予約フォーム。ご希望のメニューと日時をお送りください。凰凛より折り返しご連絡いたします。"
>
  <section class="section">
    <div class="container narrow">
      <div class="text-center reveal">
        <span class="section-label">Reservation</span>
        <h1 class="section-title">ご予約</h1>
        <p class="section-lead">
          ご希望のメニューと日時をお送りください。<br />
          内容を確認のうえ、凰凛より折り返しご連絡いたします（通常2〜3日以内）。
        </p>
      </div>

      {!ready && (
        <div class="card notice reveal">
          <p class="notice-title">✧ 予約フォームは現在準備中です</p>
          <p>
            送信先の設定（GASウェブアプリURL）が未登録のため、送信ボタンは無効になっています。<br />
            {contactNote}
            {CONTACT_EMAIL && <> （<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>）</>}
          </p>
          {hasSns && <div class="notice-sns"><SnsIcons size={20} gap={14} variant="circle" /></div>}
        </div>
      )}

      <form id="reserve-form" class="card form reveal" novalidate>
        <div class="field">
          <label for="name">お名前 <span class="req">必須</span></label>
          <input type="text" id="name" name="name" autocomplete="name" placeholder="凰凛 太郎" required />
        </div>

        <div class="field">
          <label for="email">メールアドレス <span class="req">必須</span></label>
          <input type="email" id="email" name="email" autocomplete="email" placeholder="example@mail.com" required />
          <p class="hint">確認のご連絡はこちらにお送りします。</p>
        </div>

        <div class="field">
          <label for="contact">SNSアカウント・電話番号など（任意）</label>
          <input type="text" id="contact" name="contact" placeholder="@your_account / 090-0000-0000" />
        </div>

        <div class="field">
          <label for="menu">ご希望メニュー <span class="req">必須</span></label>
          <select id="menu" name="menu" required>
            <option value="" disabled selected>選択してください</option>
            {RESERVE_MENUS.map((m) => <option value={m}>{m}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="style">鑑定の形式 <span class="req">必須</span></label>
          <div class="radio-row">
            <label class="radio"><input type="radio" name="style" value="対面" required /><span>対面</span></label>
            <label class="radio"><input type="radio" name="style" value="オンライン" /><span>オンライン</span></label>
            <label class="radio"><input type="radio" name="style" value="どちらでも" /><span>どちらでも</span></label>
          </div>
        </div>

        <fieldset class="field group">
          <legend>第1希望の日時 <span class="req">必須</span></legend>
          <div class="datetime">
            <input type="date" id="date1" name="date1" required />
            <select id="time1" name="time1" required>
              <option value="" disabled selected>時間</option>
              {RESERVE_TIME_SLOTS.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
        </fieldset>

        <fieldset class="field group">
          <legend>第2希望の日時（任意）</legend>
          <div class="datetime">
            <input type="date" id="date2" name="date2" />
            <select id="time2" name="time2">
              <option value="" selected>時間</option>
              {RESERVE_TIME_SLOTS.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
        </fieldset>

        <div class="field">
          <label for="message">ご相談内容・ご質問（任意）</label>
          <textarea id="message" name="message" rows="5" placeholder="気になっていること、聞いてみたいことをご自由にお書きください。"></textarea>
        </div>

        <label class="agree">
          <input type="checkbox" id="agree" name="agree" required />
          <span>
            鑑定は医療・法律・投資の判断に代わるものではないことに同意します。
          </span>
        </label>

        <button type="submit" id="submit-btn" class="btn btn-primary submit" disabled={!ready}>
          {ready ? 'この内容で予約を申し込む' : '準備中'}
        </button>

        <p id="result" class="result" role="status" aria-live="polite"></p>
      </form>

      <div class="after reveal">
        <h2 class="after-title">ご予約後の流れ</h2>
        <ol class="after-list">
          <li>フォーム送信後、自動で受付が登録されます（この時点ではまだ確定ではありません）。</li>
          <li>凰凛が内容を確認し、日程確定のご連絡をメールでお送りします。</li>
          <li>日程が確定したら、当日の詳細（場所またはオンラインURL）をご案内します。</li>
        </ol>
        <p class="after-note">
          数日経っても返信が届かない場合は、迷惑メールフォルダをご確認のうえ、{hasSns ? 'SNSのDM' : 'お手数ですが再度フォーム'}よりご連絡ください。
        </p>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ GAS_RESERVE_URL }}>
  (function () {
    var form = document.getElementById('reserve-form');
    var btn = document.getElementById('submit-btn');
    var result = document.getElementById('result');
    if (!form || !btn) return;

    // 過去日を選べないようにする
    var today = new Date();
    var min =
      today.getFullYear() +
      '-' +
      String(today.getMonth() + 1).padStart(2, '0') +
      '-' +
      String(today.getDate()).padStart(2, '0');
    ['date1', 'date2'].forEach(function (id) {
      var el = document.getElementById(id);
      if (el) el.min = min;
    });

    function show(message, type) {
      result.textContent = message;
      result.className = 'result ' + (type || '');
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (!GAS_RESERVE_URL) {
        show('送信先が未設定です。SNSまたはメールよりご連絡ください。', 'error');
        return;
      }
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      var data = Object.fromEntries(new FormData(form).entries());
      data.agree = form.querySelector('#agree').checked ? '同意' : '';
      data.pageUrl = location.href;

      btn.disabled = true;
      show('送信しています…', '');

      try {
        // CORSプリフライトを避けるため text/plain で送信（GAS側でJSON.parse）
        var res = await fetch(GAS_RESERVE_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(data),
        });
        var json = await res.json().catch(function () { return { ok: res.ok }; });

        if (json && json.ok) {
          form.reset();
          show('ご予約を受け付けました。折り返しご連絡いたしますので、少々お待ちください。', 'success');
        } else {
          show((json && json.message) || '送信に失敗しました。時間をおいて再度お試しください。', 'error');
          btn.disabled = false;
        }
      } catch (err) {
        show('通信に失敗しました。電波状況をご確認のうえ、もう一度お試しください。', 'error');
        btn.disabled = false;
      }
    });
  })();
</script>

<style>
  .notice { margin-top: 40px; border-color: var(--line); background: rgba(212, 175, 106, 0.08); }
  .notice-title { font-family: var(--font-serif); color: var(--gold-bright); margin: 0 0 10px; }
  .notice p { margin: 0; color: var(--muted); font-size: 0.92rem; }
  .notice-sns { margin-top: 18px; display: flex; justify-content: center; }

  .form { margin-top: 40px; display: grid; gap: 22px; }
  .field { display: grid; gap: 8px; }
  .field label,
  .field legend { font-size: 0.9rem; letter-spacing: 0.06em; }
  .group { border: 0; margin: 0; padding: 0; }
  .req { font-size: 0.66rem; color: #1a1330; background: var(--gold); border-radius: 4px; padding: 2px 7px; margin-left: 8px; letter-spacing: 0.08em; vertical-align: 2px; }
  .hint { margin: 0; font-size: 0.78rem; color: var(--muted); }

  input[type='text'],
  input[type='email'],
  input[type='date'],
  select,
  textarea {
    width: 100%;
    padding: 13px 16px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.05);
    color: var(--text);
    font-family: inherit;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  input::placeholder,
  textarea::placeholder { color: rgba(167, 159, 192, 0.6); }
  input:focus,
  select:focus,
  textarea:focus { border-color: var(--gold); background: rgba(255, 255, 255, 0.08); }
  select option { background: #171330; color: var(--text); }
  textarea { resize: vertical; line-height: 1.8; }
  input[type='date'] { color-scheme: dark; }

  .datetime { display: grid; grid-template-columns: 1.4fr 1fr; gap: 12px; }

  .radio-row { display: flex; flex-wrap: wrap; gap: 10px; }
  .radio { display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 999px; cursor: pointer; font-size: 0.9rem; transition: border-color 0.2s ease, background 0.2s ease; }
  .radio:hover { border-color: var(--line); }
  .radio input { accent-color: #d4af6a; }
  .radio:has(input:checked) { border-color: var(--gold); background: rgba(212, 175, 106, 0.14); }

  .agree { display: flex; align-items: flex-start; gap: 10px; font-size: 0.88rem; color: var(--muted); line-height: 1.7; }
  .agree input { margin-top: 6px; accent-color: #d4af6a; }

  .submit { width: 100%; margin-top: 6px; border: 0; }
  .submit:disabled { opacity: 0.45; cursor: not-allowed; box-shadow: none; transform: none; }

  .result { margin: 0; min-height: 1.4em; text-align: center; font-size: 0.9rem; }
  .result.success { color: #8ad6a8; }
  .result.error { color: #ff9d9d; }

  .after { margin-top: 56px; }
  .after-title { font-size: 1.15rem; margin: 0 0 18px; }
  .after-list { margin: 0; padding-left: 1.3em; color: var(--muted); font-size: 0.92rem; }
  .after-list li { margin-bottom: 10px; }
  .after-list li::marker { color: var(--gold); }
  .after-note { margin-top: 18px; font-size: 0.82rem; color: rgba(167, 159, 192, 0.8); }

  @media (max-width: 560px) {
    .datetime { grid-template-columns: 1fr; }
  }
</style>
