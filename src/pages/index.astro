---
import Layout from '../layouts/Layout.astro';
import SnsIcons from '../components/SnsIcons.astro';
import { PROFILE_IMAGE, SNS_LINKS } from '../consts';
import { withBase } from '../lib/url';
import { queryDatabase, getTitle, getDateStr, getSlug, getStatus, getMultiSelect, getImageUrl, getText, formatDate } from '../lib/notion';

// 活動報告（ブログ）の最新3件を Notion から取得
const blogDbId = import.meta.env.NOTION_BLOG_ID;
const pages = await queryDatabase(blogDbId, {
  sorts: [{ timestamp: 'created_time', direction: 'descending' }],
});

const posts = pages
  .filter((p: any) => {
    const status = getStatus(p);
    return status === '' || status === '公開' || status === 'Published' || status === '完了';
  })
  .map((p: any) => ({
    title: getTitle(p),
    date: getDateStr(p),
    slug: getSlug(p),
    categories: getMultiSelect(p),
    image: getImageUrl(p),
    summary: getText(p, ['概要', '抜粋', 'サマリー']),
  }))
  .sort((a, b) => (a.date < b.date ? 1 : -1))
  .slice(0, 3);

const hasSns = SNS_LINKS.some((s) => s.url);

const divinations = [
  {
    en: 'Channeling',
    ja: 'チャネリング',
    text: '目には見えない領域とつながり、いま必要なメッセージを受け取ってお伝えします。「頭ではわかっているのに動けない」——そんなときに、心の奥にある本当の声を言葉にしていきます。',
    points: ['進むべき方向を確かめたいとき', '人間関係のもつれをほどきたいとき', '自分の本音がわからなくなったとき'],
  },
  {
    en: 'Lenormand',
    ja: 'ルノルマンカード',
    text: '36枚のカードが描くのは、日常のなかの具体的な出来事。抽象的な励ましではなく、「いつ・どこで・何が起こりやすいか」を現実的な言葉で読み解きます。',
    points: ['近い未来の流れを知りたいとき', '選択肢のどちらを選ぶか迷うとき', '具体的なアドバイスが欲しいとき'],
  },
];
---

<Layout>
  <!-- ヒーロー -->
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <img class="hero-mark" src={withBase("/images/ourin-logo-ink.png")} alt="" aria-hidden="true" />
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="hero-en">Channeling &amp; Lenormand</p>
        <h1 class="hero-title">
          あなたの<span class="accent">今</span>に、<br />
          いちばん必要な言葉を。
        </h1>
        <p class="hero-lead">
          占い師・凰凛（おうりん）です。<br />
          チャネリングとルノルマンカードで、迷いのなかにある「本当の答え」を一緒に見つけていきます。
        </p>
        <div class="hero-actions">
          <a href={withBase("/reserve")} class="btn btn-primary">鑑定を予約する</a>
          <a href={withBase("/menu")} class="btn btn-ghost">占術メニューを見る</a>
        </div>
        {hasSns && (
          <div class="hero-sns">
            <span class="hero-sns-label">Follow</span>
            <SnsIcons size={20} gap={18} />
          </div>
        )}
      </div>

      <div class="hero-photo">
        <div class="photo-frame">
          <img src={withBase(PROFILE_IMAGE)} alt="占い師 凰凛" width="440" height="560" fetchpriority="high" />
        </div>
        <p class="photo-name">凰 凛<span>Ourin</span></p>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- 占術 -->
  <section class="section" id="divination">
    <div class="container">
      <div class="text-center reveal">
        <span class="section-label">Divination</span>
        <h2 class="section-title">二つの視点で読み解く</h2>
        <p class="section-lead">
          見えない領域からのメッセージ（チャネリング）と、現実の流れを描くカード（ルノルマン）。<br />
          ふたつを合わせることで、「気持ち」と「現実」の両方に届く鑑定になります。
        </p>
      </div>

      <div class="divination-grid">
        {divinations.map((d) => (
          <article class="card divination-card reveal">
            <p class="divination-en">{d.en}</p>
            <h3 class="divination-ja">{d.ja}</h3>
            <p class="divination-text">{d.text}</p>
            <ul class="divination-points">
              {d.points.map((p) => <li>{p}</li>)}
            </ul>
          </article>
        ))}
      </div>

      <div class="text-center" style="margin-top: 36px;">
        <a href={withBase("/menu")} class="btn btn-ghost">メニューと料金を見る</a>
      </div>
    </div>
  </section>

  <!-- 活動報告 -->
  <section class="section" id="report">
    <div class="container">
      <div class="text-center reveal">
        <span class="section-label">Report</span>
        <h2 class="section-title">活動報告</h2>
        <p class="section-lead">イベント出店・セッションの様子・日々の気づきなどを綴っています。</p>
      </div>

      {posts.length > 0 ? (
        <div class="post-grid">
          {posts.map((post) => (
            <a class="post-card reveal" href={withBase(`/blog/${post.slug}`)}>
              <div class="post-thumb">
                {post.image ? (
                  <img src={post.image} alt="" loading="lazy" />
                ) : (
                  <span class="post-thumb-mark">✧</span>
                )}
              </div>
              <div class="post-body">
                <p class="post-date">{formatDate(post.date)}</p>
                <h3 class="post-title">{post.title}</h3>
                {post.categories.length > 0 && (
                  <p class="post-tags">{post.categories.map((c) => <span class="tag">{c}</span>)}</p>
                )}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="card empty reveal">
          <p>ただいま準備中です。Notionの活動報告データベースに記事を追加すると、ここに表示されます。</p>
        </div>
      )}

      <div class="text-center" style="margin-top: 36px;">
        <a href={withBase("/blog")} class="btn btn-ghost">活動報告をもっと見る</a>
      </div>
    </div>
  </section>

  <!-- SNS -->
  {hasSns && (
    <section class="section-sm">
      <div class="container text-center reveal">
        <span class="section-label">Follow me</span>
        <h2 class="section-title">SNSでも発信しています</h2>
        <p class="section-lead">日々のメッセージ・出店情報はSNSでいち早くお知らせしています。</p>
        <div class="sns-center">
          <SnsIcons size={22} gap={16} variant="circle" />
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="section">
    <div class="container">
      <div class="cta reveal">
        <span class="section-label">Reservation</span>
        <h2 class="cta-title">鑑定のご予約</h2>
        <p class="cta-text">
          ご希望の日時とメニューを送信いただくと、凰凛より折り返しご連絡いたします。<br />
          はじめての方も、どうぞ安心してお越しください。
        </p>
        <a href={withBase("/reserve")} class="btn btn-primary">予約フォームへ進む</a>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  /* トップページはヒーローの書を主役にするため、ページ全体のウォーターマークは出さない */
  body::after { display: none; }
</style>

<style>
  /* ヒーロー */
  .hero { position: relative; overflow: hidden; padding: 72px 0 84px; }
  .hero-glow {
    position: absolute;
    top: -220px;
    right: -140px;
    width: 620px;
    height: 620px;
    background: radial-gradient(circle, rgba(127, 208, 232, 0.5), transparent 65%);
    filter: blur(10px);
    pointer-events: none;
  }
  /* ヒーロー背面に大きく置いた「凰凛」の書 */
  .hero-mark {
    position: absolute;
    top: 50%;
    left: 2%;
    height: 116%;
    width: auto;
    transform: translateY(-50%);
    opacity: 0.1;
    pointer-events: none;
    user-select: none;
  }
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
  }
  .hero-en { font-family: var(--font-serif); font-size: 0.78rem; letter-spacing: 0.34em; color: var(--accent); margin: 0 0 18px; }
  .hero-title { font-size: clamp(1.75rem, 4.4vw, 2.6rem); line-height: 1.6; margin: 0 0 24px; }
  .hero-title .accent {
    color: var(--accent-deep);
    position: relative;
    padding: 0 2px;
  }
  .hero-lead { color: var(--muted); margin: 0 0 32px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; }
  .hero-sns { display: flex; align-items: center; gap: 18px; margin-top: 34px; }
  .hero-sns-label { font-family: var(--font-serif); font-size: 0.7rem; letter-spacing: 0.28em; color: var(--muted); }

  .hero-photo { display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .photo-frame {
    position: relative;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 220px 220px 24px 24px;
    background: linear-gradient(160deg, rgba(127, 208, 232, 0.35), rgba(47, 143, 207, 0.18));
  }
  .photo-frame img {
    display: block;
    width: 100%;
    max-width: 380px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: top center;
    border-radius: 210px 210px 16px 16px;
    box-shadow: var(--shadow-lg);
  }
  .photo-name {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    letter-spacing: 0.4em;
    margin: 0;
    text-align: center;
  }
  .photo-name span { display: block; font-size: 0.62rem; letter-spacing: 0.36em; color: var(--muted); margin-top: 8px; }

  /* 占術カード */
  .divination-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 26px; margin-top: 46px; }
  .divination-card { position: relative; transition: transform 0.3s ease, border-color 0.3s ease; }
  .divination-card:hover { transform: translateY(-4px); border-color: var(--line); }
  .divination-en { font-family: var(--font-serif); font-size: 0.72rem; letter-spacing: 0.3em; color: var(--accent); margin: 0 0 8px; }
  .divination-ja { font-size: 1.3rem; margin: 0 0 16px; }
  .divination-text { color: var(--muted); font-size: 0.95rem; margin: 0 0 20px; }
  .divination-points { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .divination-points li { position: relative; padding-left: 20px; font-size: 0.9rem; }
  .divination-points li::before { content: '✧'; position: absolute; left: 0; color: var(--accent); }

  /* 記事カード */
  .post-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-top: 46px; }
  .post-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var(--panel);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .post-card:hover { transform: translateY(-4px); border-color: var(--line); box-shadow: var(--shadow-md); }
  .post-thumb {
    aspect-ratio: 16 / 10;
    background: linear-gradient(150deg, rgba(127, 208, 232, 0.45), rgba(220, 239, 251, 0.9));
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .post-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .post-thumb-mark { font-size: 1.8rem; color: var(--accent); }
  .post-body { padding: 20px 22px 24px; }
  .post-date { font-size: 0.75rem; letter-spacing: 0.16em; color: var(--accent); margin: 0 0 8px; }
  .post-title { font-size: 1.05rem; margin: 0 0 12px; line-height: 1.7; }
  .post-tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; }
  .tag { font-size: 0.72rem; color: var(--muted); border: 1px solid var(--border); border-radius: 999px; padding: 2px 12px; }

  .empty { margin-top: 40px; text-align: center; color: var(--muted); }
  .sns-center { display: flex; justify-content: center; margin-top: 28px; }

  /* CTA */
  .cta {
    text-align: center;
    padding: 56px 28px;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: linear-gradient(160deg, rgba(127, 208, 232, 0.28), rgba(255, 255, 255, 0.9));
  }
  .cta-title { font-size: clamp(1.4rem, 4vw, 1.9rem); margin: 0 0 16px; }
  .cta-text { color: var(--muted); margin: 0 0 28px; }

  @media (max-width: 860px) {
    .hero { padding: 48px 0 60px; }
    .hero-mark { left: 50%; height: 70%; transform: translate(-50%, -50%); opacity: 0.08; }
    .hero-inner { grid-template-columns: 1fr; gap: 44px; }
    .hero-photo { order: -1; }
    .photo-frame img { max-width: 300px; }
    .hero-actions .btn { flex: 1 1 auto; text-align: center; }
  }
</style>
