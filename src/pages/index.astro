---
import Layout from '../layouts/Layout.astro';
import SnsIcons from '../components/SnsIcons.astro';
import { PROFILE_IMAGE, SNS_LINKS, SERVICES, LINE_BUSINESS_URL, LINE_FORTUNE_URL } from '../consts';
import { withBase } from '../lib/url';
import { formatDate } from '../lib/notion';
import { getAllPosts } from '../lib/blog';

// 活動報告の最新3件（Notion＋サイト内記事）
const posts = (await getAllPosts()).slice(0, 3);

const hasSns = SNS_LINKS.some((s) => s.url);
const [featured, ...others] = SERVICES;
---

<Layout>
  <!-- ヒーロー -->
  <section class="hero">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="hero-en">Noriko Matsuyama</p>
        <h1 class="hero-title">
          働く選択肢を、<br />
          もっと<span class="accent">自由</span>に。
        </h1>
        <p class="hero-lead">
          シングルマザーとして、収入・自由・やりがいを同時に手に入れた経験をもとに、<br />
          同じ想いを持つ女性たちにチャンスを届けています。
        </p>
        <div class="hero-actions">
          <a href={withBase('/service')} class="btn btn-primary">3つの事業を見る</a>
          <a href={withBase('/contact')} class="btn btn-ghost">お問い合わせ</a>
        </div>
        {hasSns && (
          <div class="hero-sns">
            <span class="hero-sns-label">Follow</span>
            <SnsIcons size={20} gap={18} />
          </div>
        )}
      </div>

      <div class="hero-photo">
        <div class="photo-frame">
          <img src={withBase(PROFILE_IMAGE)} alt="松山倫子" width="440" height="560" fetchpriority="high" />
        </div>
        <p class="photo-name">松山 倫子<span>Noriko Matsuyama</span></p>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- 事業紹介 -->
  <section class="section" id="service">
    <div class="container">
      <div class="text-center reveal">
        <span class="section-label">Service</span>
        <h2 class="section-title">3つの事業</h2>
        <p class="section-lead">
          占い師が活躍できるコミュニティ、在宅ではじめられるテレアポ、スキルが収入に直結する営業代行。<br />
          「時間も収入も、自分でコントロールできる働き方」への入り口をご用意しています。
        </p>
      </div>

      <!-- 01 占いコミュニティ（一番上・大きく） -->
      <article class="featured reveal">
        <div class="featured-body">
          <p class="featured-no">{featured.no}｜{featured.en}</p>
          <h3 class="featured-name">{featured.name}</h3>
          <p class="featured-lead">{featured.lead}</p>
          <p class="featured-summary">{featured.summary}</p>
          <ul class="check-list">
            {featured.points.map((p) => <li>{p}</li>)}
          </ul>
          <div class="featured-actions">
            <a href={withBase(`/service/${featured.id}`)} class="btn btn-primary">くわしく見る</a>
            {featured.lineUrl && (
              <a href={featured.lineUrl} class="btn btn-line" target="_blank" rel="noopener noreferrer">
                公式LINEで相談する
              </a>
            )}
          </div>
        </div>
        <aside class="featured-side">
          <p class="side-label">こんな方に</p>
          <ul class="side-list">
            {featured.target.map((t) => <li>{t}</li>)}
          </ul>
          {featured.note && <p class="side-note">{featured.note}</p>}
        </aside>
      </article>

      <!-- 02・03 -->
      <div class="service-grid">
        {others.map((s) => (
          <article class="card service-card reveal">
            <p class="service-no">{s.no}｜{s.en}</p>
            <h3 class="service-name">{s.name}</h3>
            <p class="service-lead">{s.lead}</p>
            <p class="service-summary">{s.summary}</p>
            <ul class="check-list small">
              {s.points.slice(0, 4).map((p) => <li>{p}</li>)}
            </ul>
            <div class="service-actions">
              <a href={withBase(`/service/${s.id}`)} class="btn btn-primary">くわしく見る</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>


  <!-- 占い師としての名前「凰凛」 -->
  <section class="section-sm">
    <div class="container">
      <div class="alias reveal">
        <div class="alias-mark">
          <img src={withBase('/images/ourin-logo-ink.png')} alt="凰凛" width="200" height="282" loading="lazy" />
        </div>
        <div class="alias-text">
          <span class="section-label">Another Name</span>
          <h2 class="section-title left">占い師としての名前、<br />凰凛（おうりん）。</h2>
          <p>
            チャネリングとルノルマンカードで、その人の「いま」に必要なメッセージをお伝えしています。
            占い師として現場に立ってきた経験が、占いコミュニティの運営にもそのまま生きています。
          </p>
          <div class="alias-tags">
            <span class="alias-tag">チャネリング</span>
            <span class="alias-tag">ルノルマンカード</span>
          </div>
          <div class="alias-actions">
            <a href={withBase('/ourin')} class="btn btn-primary">占い師 凰凛について</a>
            <a href={withBase('/contact')} class="btn btn-ghost">個人鑑定を相談する</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- プロフィール抜粋 -->
  <section class="section-sm">
    <div class="container">
      <div class="about-box reveal">
        <div class="about-photo">
          <img src={withBase(PROFILE_IMAGE)} alt="" width="360" height="450" loading="lazy" />
        </div>
        <div class="about-text">
          <span class="section-label">About</span>
          <h2 class="section-title left">46歳、2児のシングルマザー。</h2>
          <p>
            育児と仕事を両立しながら、テレアポ・営業代行・イベント事業の3つを手がけています。
            「時間も収入も、自分でコントロールできる働き方」を実践しながら、
            同じ境遇の女性たちが一歩踏み出せる環境づくりに取り組んでいます。
          </p>
          <a href={withBase('/about')} class="btn btn-ghost">プロフィールを見る</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 活動報告 -->
  <section class="section" id="report">
    <div class="container">
      <div class="text-center reveal">
        <span class="section-label">Report</span>
        <h2 class="section-title">活動報告</h2>
        <p class="section-lead">定例会・交流会・イベント出店など、コミュニティの活動をレポートしています。</p>
      </div>

      {posts.length > 0 ? (
        <div class="post-grid">
          {posts.map((post) => (
            <a class="post-card reveal" href={withBase(`/blog/${post.slug}`)}>
              <div class="post-thumb">
                {post.image ? (
                  <img src={post.source === 'local' ? withBase(post.image) : post.image} alt="" loading="lazy" />
                ) : (
                  <span class="post-thumb-mark">✧</span>
                )}
              </div>
              <div class="post-body">
                <p class="post-date">{formatDate(post.date)}</p>
                <h3 class="post-title">{post.title}</h3>
                {post.categories.length > 0 && (
                  <p class="post-tags">{post.categories.map((c) => <span class="tag">{c}</span>)}</p>
                )}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="card empty reveal">
          <p>ただいま準備中です。Notionの活動報告データベースに記事を追加すると、ここに表示されます。</p>
        </div>
      )}

      <div class="text-center" style="margin-top: 36px;">
        <a href={withBase('/blog')} class="btn btn-ghost">活動報告をもっと見る</a>
      </div>
    </div>
  </section>

  <!-- SNS -->
  {hasSns && (
    <section class="section-sm">
      <div class="container text-center reveal">
        <span class="section-label">Follow me</span>
        <h2 class="section-title">SNSでも発信しています</h2>
        <p class="section-lead">定例会やイベントのお知らせ、日々の活動はSNSでいち早くお届けしています。</p>
        <div class="sns-center">
          <SnsIcons size={22} gap={16} variant="circle" />
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="section">
    <div class="container">
      <div class="cta reveal">
        <span class="section-label">Contact</span>
        <h2 class="cta-title">お問い合わせ</h2>
        <p class="cta-text">
          各事業へのご参加・ご相談はお気軽にどうぞ。<br />
          一緒に新しいステージへ踏み出しましょう。
        </p>
        <div class="cta-actions">
          <a href={LINE_FORTUNE_URL} class="btn btn-line" target="_blank" rel="noopener noreferrer">
            占いのLINE相談
          </a>
          <a href={LINE_BUSINESS_URL} class="btn btn-line" target="_blank" rel="noopener noreferrer">
            お仕事のLINE相談
          </a>
          <a href={withBase('/contact')} class="btn btn-ghost">お問い合わせ</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ヒーロー */
  .hero { position: relative; overflow: hidden; padding: 72px 0 84px; }
  .hero-glow {
    position: absolute;
    top: -220px;
    right: -140px;
    width: 620px;
    height: 620px;
    background: radial-gradient(circle, rgba(111, 224, 180, 0.5), transparent 65%);
    filter: blur(10px);
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
  }
  .hero-en { font-family: var(--font-serif); font-size: 0.78rem; letter-spacing: 0.34em; color: var(--accent); margin: 0 0 18px; }
  .hero-title { font-size: clamp(1.9rem, 4.8vw, 3rem); line-height: 1.55; margin: 0 0 24px; }
  .hero-title .accent { color: var(--accent-deep); }
  .hero-lead { color: var(--muted); margin: 0 0 32px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; }
  .hero-sns { display: flex; align-items: center; gap: 18px; margin-top: 34px; }
  .hero-sns-label { font-family: var(--font-serif); font-size: 0.7rem; letter-spacing: 0.28em; color: var(--muted); }

  .hero-photo { display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .photo-frame {
    position: relative;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 220px 220px 24px 24px;
    background: linear-gradient(160deg, rgba(111, 224, 180, 0.35), rgba(14, 165, 120, 0.18));
  }
  .photo-frame img {
    display: block;
    width: 100%;
    max-width: 380px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: top center;
    border-radius: 210px 210px 16px 16px;
    box-shadow: var(--shadow-lg);
  }
  .photo-name { font-family: var(--font-serif); font-size: 1.25rem; letter-spacing: 0.4em; margin: 0; text-align: center; }
  .photo-name span { display: block; font-size: 0.62rem; letter-spacing: 0.36em; color: var(--muted); margin-top: 8px; }

  /* 01 占いコミュニティ（フィーチャー） */
  .featured {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: 0;
    margin-top: 48px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 22px;
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }
  .featured-body { padding: 40px 42px; }
  .featured-no { font-family: var(--font-serif); font-size: 0.74rem; letter-spacing: 0.24em; color: var(--accent); margin: 0 0 10px; }
  .featured-name { font-size: 1.5rem; margin: 0 0 10px; }
  .featured-lead { font-family: var(--font-serif); font-size: 1.05rem; color: var(--accent-deep); margin: 0 0 18px; }
  .featured-summary { color: var(--muted); font-size: 0.95rem; margin: 0 0 22px; }
  .featured-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  .featured-side {
    padding: 40px 34px;
    background: linear-gradient(170deg, rgba(111, 224, 180, 0.28), rgba(213, 247, 232, 0.75));
    border-left: 1px solid var(--border);
  }
  .side-label { font-family: var(--font-serif); font-size: 0.72rem; letter-spacing: 0.24em; color: var(--accent-deep); margin: 0 0 14px; }
  .side-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .side-list li { position: relative; padding-left: 18px; font-size: 0.88rem; }
  .side-list li::before { content: ''; position: absolute; left: 0; top: 0.75em; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
  .side-note { margin: 20px 0 0; font-size: 0.82rem; color: var(--accent-deep); font-weight: 500; line-height: 1.8; }

  .check-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .check-list li { position: relative; padding-left: 26px; font-size: 0.92rem; }
  .check-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    width: 18px;
    height: 18px;
    margin-top: 4px;
    border-radius: 50%;
    background: var(--accent-pale);
    color: var(--accent-deep);
    font-size: 0.7rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .check-list.small li { font-size: 0.88rem; }

  /* 02・03 */
  .service-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 26px; margin-top: 26px; }
  .service-card { display: flex; flex-direction: column; transition: transform 0.3s ease, box-shadow 0.3s ease; }
  .service-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .service-no { font-family: var(--font-serif); font-size: 0.72rem; letter-spacing: 0.24em; color: var(--accent); margin: 0 0 8px; }
  .service-name { font-size: 1.22rem; margin: 0 0 8px; }
  .service-lead { font-family: var(--font-serif); font-size: 0.98rem; color: var(--accent-deep); margin: 0 0 14px; }
  .service-summary { color: var(--muted); font-size: 0.9rem; margin: 0 0 18px; }
  /* 「くわしく見る」の幅は01（占いコミュニティ）のボタンと揃える */
  .service-actions { margin-top: auto; padding-top: 24px; }


  /* 占い師としての名前ブロック */
  .alias {
    display: grid;
    grid-template-columns: 0.34fr 0.66fr;
    gap: 44px;
    align-items: center;
    padding: 44px 46px;
    background: linear-gradient(160deg, rgba(213, 247, 232, 0.75), var(--panel) 65%);
    border: 1px solid var(--border);
    border-radius: 22px;
    box-shadow: var(--shadow-sm);
  }
  .alias-mark { display: flex; justify-content: center; }
  .alias-mark img { height: 220px; width: auto; opacity: 0.9; }
  .alias-text p { color: var(--muted); margin: 0 0 22px; }
  .alias-tags { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 26px; }
  .alias-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .alias-tag {
    font-size: 0.82rem;
    color: var(--accent-deep);
    background: var(--accent-pale);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 6px 16px;
  }

  /* プロフィール抜粋 */
  .about-box {
    display: grid;
    grid-template-columns: 0.4fr 0.6fr;
    gap: 44px;
    align-items: center;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 22px;
    box-shadow: var(--shadow-sm);
    padding: 40px 44px;
  }
  .about-photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: top center;
    border-radius: 180px 180px 18px 18px;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-md);
  }
  .about-text p { color: var(--muted); margin: 0 0 26px; }

  /* 記事カード */
  .post-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-top: 46px; }
  .post-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var(--panel);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .post-card:hover { transform: translateY(-4px); border-color: var(--line); box-shadow: var(--shadow-md); }
  .post-thumb {
    aspect-ratio: 16 / 10;
    background: linear-gradient(150deg, rgba(111, 224, 180, 0.45), rgba(213, 247, 232, 0.9));
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .post-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .post-thumb-mark { font-size: 1.8rem; color: var(--accent); }
  .post-body { padding: 20px 22px 24px; }
  .post-date { font-size: 0.75rem; letter-spacing: 0.16em; color: var(--accent); margin: 0 0 8px; }
  .post-title { font-size: 1.05rem; margin: 0 0 12px; line-height: 1.7; }
  .post-tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; }
  .tag { font-size: 0.72rem; color: var(--muted); border: 1px solid var(--border); border-radius: 999px; padding: 2px 12px; }

  .empty { margin-top: 40px; text-align: center; color: var(--muted); }
  .sns-center { display: flex; justify-content: center; margin-top: 28px; }

  /* CTA */
  .cta {
    text-align: center;
    padding: 56px 28px;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: linear-gradient(160deg, rgba(111, 224, 180, 0.3), rgba(255, 255, 255, 0.9));
    box-shadow: var(--shadow-sm);
  }
  .cta-title { font-size: clamp(1.4rem, 4vw, 1.9rem); margin: 0 0 16px; }
  .cta-text { color: var(--muted); margin: 0 0 28px; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; }

  @media (max-width: 900px) {
    .alias { grid-template-columns: 1fr; gap: 28px; padding: 32px 26px; text-align: center; }
    .alias-mark img { height: 150px; }
    .alias-tags { justify-content: center; }
    .featured { grid-template-columns: 1fr; }
    .featured-body { padding: 32px 26px; }
    .featured-side { padding: 30px 26px; border-left: 0; border-top: 1px solid var(--border); }
    .about-box { grid-template-columns: 1fr; gap: 28px; padding: 30px 26px; }
    .about-photo { max-width: 260px; margin-inline: auto; }
  }

  @media (max-width: 860px) {
    .hero { padding: 48px 0 60px; }
    .hero-inner { grid-template-columns: 1fr; gap: 44px; }
    .hero-photo { order: -1; }
    .photo-frame img { max-width: 300px; }
    .hero-actions .btn { flex: 1 1 auto; text-align: center; }
  }
</style>
